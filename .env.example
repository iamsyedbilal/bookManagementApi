PORT=3000
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017
DB_NAME=book_management
NODE_ENV=development

# Replace both with separately generated random values (minimum 32 characters).
ACCESS_TOKEN_SECRET=replace_with_a_unique_random_access_secret_48_chars
REFRESH_TOKEN_SECRET=replace_with_a_different_random_refresh_secret_48_chars

# Exact browser origins, comma-separated. Leave empty to deny cross-origin browser access.
CORS_ORIGINS=http://localhost:5173

# Used only by scripts/seedAdmin.js. Replace before running the seed script.
ADMIN_NAME=Local Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_this_local_admin_password
